<Project Sdk="WixToolset.Sdk/5.0.2">
  <PropertyGroup>
	  <Version>0.0.0</Version>
	  <Platform Condition="'$(Platform)' == ''">x64</Platform>
    <DefineConstants>
		Manufacturer=JTDev;
		ProductName=Radio Automation;
		PublishFolder=$(SolutionDir)\publish\Radio Automation;
		Version=$(Version);
		ReleaseType=$(Environment)
	</DefineConstants>
	  <OutputPath>$(SolutionDir)\Release</OutputPath>
	  <OutputName>Radio-Automation-v$(Version)-$(Platform)</OutputName>
  </PropertyGroup>

	<!-- A Release MSI built without publish output would be empty (WIX8601/WIX1076); fail with a clear message instead. -->
	<Target Name="RequirePublishFolder" BeforeTargets="PrepareForBuild" Condition="'$(Configuration)' == 'Release' And !Exists('$(MSBuildThisFileDirectory)..\publish\Radio Automation')">
		<Error Text="Publish output not found at '$(MSBuildThisFileDirectory)..\publish\Radio Automation'. Run 'dotnet publish' for Radio Automation before building the installer." />
	</Target>

	<Target Name="EchoVariables" BeforeTargets="Build">
		<Message Text="Configuration: $(Configuration)" Importance="high" />
		<Message Text="PublishFolder: $(PublishFolder)" Importance="high" />
	</Target>

  <ItemGroup>
    <ProjectReference Include="..\Radio Automation\Radio Automation.csproj" />
  </ItemGroup>
</Project>